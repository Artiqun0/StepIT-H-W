<Window x:Class="_23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border
        Width="700"
        Height="400"
        Background="AliceBlue"
        CornerRadius="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.15*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Border 
                Background="AliceBlue"
                CornerRadius="20"
                MouseLeftButtonDown="DragWindow">

                <Button
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Foreground="Black"
                    Click="Close"
                    Style="{DynamicResource MaterialDesignIconButton}">

                    <md:PackIcon Kind="Close"/>
                </Button>
            </Border>

            <Border
                Grid.Row="1"
                Width="600"
                Height="40"
                Background="Silver"
                HorizontalAlignment="Left"
                CornerRadius="10">

                <TextBox
                    x:Name="SearchText"
                    CaretBrush="Black"
                    Margin="10 0 0 0"
                    FontSize="25"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="0"
                    Style="{DynamicResource MaterialDesignDataGridTextColumnEditingStyle}">

                </TextBox>
            </Border>
            
            <Button
                Margin="0 0 10 0"
                Width="50"
                Height="50"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Foreground="Silver"
                Click="Search"
                Style="{DynamicResource MaterialDesignIconButton}">

                <md:PackIcon Kind="Search" Width="40" Height="40"/>
            </Button>

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Hidden">

                <ItemsControl ItemsSource="{Binding Movies}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="Save"
                                Width="600"
                                Height="70"
                                Style="{DynamicResource MaterialDesignToolForegroundButton}">

                                <Border
                                    Width="500"
                                    Height="60"
                                    Grid.Row="1"
                                    Background="#272B2F"
                                    CornerRadius="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="3*"/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Text="{Binding Name}"
                                            Foreground="White"
                                            VerticalAlignment="Bottom"
                                            FontSize="20">
                                        </TextBlock>

                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Text="{Binding Year}"
                                            Foreground="White"
                                            VerticalAlignment="Bottom"
                                            FontSize="20">
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>